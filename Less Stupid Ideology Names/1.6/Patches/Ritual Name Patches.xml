<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationSequence">
    <operations>
    <li Class="PatchOperationReplace">
      <xpath>/Defs/RulePackDef[defName="NamerFestivalGlobal"]/rulePack</xpath>
      <value>
        <rulePack>
          <rulesStrings>
            <li>festivalName->[chosenAdjective] [festival]</li>
            <li>festivalName->[festival] of [chosenIdeoName]</li>

            <li>festival->festival</li>
            <li>festival->celebration</li>
            <li>festival->party</li>
            <li>festival->advent</li>

            <!-- New Terms -->

            <li>festival->holiday</li>
            <li>festival->observance</li>
            <li>festival->declaration</li>
          </rulesStrings>
        </rulePack>
      </value>
    </li>

    <!-- Building Names -->

    <li Class="PatchOperationReplace">
      <xpath>/Defs/RulePackDef[defName="NamerRitualFuneral"]/rulePack</xpath>
      <value>
        <rulePack>
          <rulesStrings>
            <li>r_ritualName->funeral</li>
          </rulesStrings>
        </rulePack>
      </value>
    </li>

    <li Class="PatchOperationReplace">
      <xpath>/Defs/RulePackDef[defName="NamerRitualGladiatorDuel"]/rulePack</xpath>
      <value>
        <rulePack>
          <rulesStrings>
            <li>r_ritualName->gladiator duel</li>
          </rulesStrings>
        </rulePack>
      </value>
    </li>

    <li Class="PatchOperationReplace">
      <xpath>/Defs/RulePackDef[defName="NamerRitualMutilation"]/rulePack</xpath>
      <value>
        <rulePack>
          <rulesStrings>
            <li>r_ritualName->scarification</li>
          </rulesStrings>
        </rulePack>
      </value>
    </li>

    <li Class="PatchOperationReplace">
      <xpath>/Defs/RulePackDef[defName="NamerRitualSacrifice"]/rulePack</xpath>
      <value>
        <rulePack>
          <rulesStrings>
            <li>r_ritualName->[chosenAdjective] sacrifice</li>
          </rulesStrings>
        </rulePack>
      </value>
    </li>
  </operations>
  </Operation>
</Patch>
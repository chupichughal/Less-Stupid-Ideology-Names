<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Ideology Expanded - Memes and Structures</li>
		</mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/RulePackDef[defName="VME_RoleFireKeeper"]/rulePack/rulesStrings</xpath>
          <value>
            <rulesStrings>
              <li>r_roleName->firekeeper</li>
            </rulesStrings>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/RulePackDef[defName="VME_Mechacker"]/rulePack/rulesStrings</xpath>
          <value>
            <rulesStrings>
              <li>r_roleName->mechhacker</li>
            </rulesStrings>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/RulePackDef[defName="VME_PartyHost"]/rulePack/rulesStrings</xpath>
          <value>
            <rulesStrings>
              <li>r_roleName->party host</li>
            </rulesStrings>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/RulePackDef[defName="VME_InsectoidHerder"]/rulePack/rulesStrings</xpath>
          <value>
            <rulesStrings>
              <li>r_roleName->insectoid herder</li>
            </rulesStrings>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/RulePackDef[defName="VME_Trader"]/rulePack/rulesStrings</xpath>
          <value>
            <rulesStrings>
              <li>r_roleName->trader</li>
            </rulesStrings>
          </value>
        </li>
        
        <li Class="PatchOperationReplace">
          <xpath>/Defs/RulePackDef[defName="VME_Patissier"]/rulePack/rulesStrings</xpath>
          <value>
            <rulesStrings>
              <li>r_roleName->patissier</li>
            </rulesStrings>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationFindMod">
      <mods>
        <li>Conservationist and Polluter - Mort's Ideologies: Memes and Precepts</li>
      </mods>
      <match Class="PatchOperationSequence">
        <operations>
          <li Class="PatchOperationReplace">
            <xpath>/Defs/RulePackDef[defName="NamerRoleCleanupSpecialist"]/rulePack/rulesStrings</xpath>
            <value>
              <rulesStrings>
                <li>r_roleName->cleanup specialist</li>
              </rulesStrings>
            </value>
          </li>
        </operations>
      </match>
  </Operation>
  <Operation Class="PatchOperationFindMod">
      <mods>
        <li>Political Compass - Mort's Ideologies</li>
      </mods>
      <match Class="PatchOperationSequence">
        <operations>
          <li Class="PatchOperationReplace">
            <xpath>/Defs/RulePackDef[defName="NamerRoleExecutive"]/rulePack/rulesStrings</xpath>
            <value>
              <rulesStrings>
                <li>r_roleName->executive</li>
              </rulesStrings>
            </value>
          </li>
        </operations>
      </match>
  </Operation>
    <Operation Class="PatchOperationFindMod">
      <mods>
        <li>Alpha Memes</li>
      </mods>
      <match Class="PatchOperationSequence">
        <operations>
          <li Class="PatchOperationReplace">
            <xpath>/Defs/RulePackDef[defName="AM_BanquetNamer"]/rulePack/rulesStrings</xpath>
            <value>
              <rulesStrings>
                <li>buildingName->banquet</li>
              </rulesStrings>
            </value>
          </li>
        </operations>
      </match>
  </Operation>
</Patch>